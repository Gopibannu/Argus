# =====================================================================
# Argus Environment Configuration Template
# Copy this file to .env and fill in your values
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL on Supabase or Neon)
# Example: postgresql://postgres.xxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/argus

# Session Secret (Opaque DB sessions salt)
SESSION_SECRET=e7b4c910385dfa62a9841e21b04cf7a301298457816ef1092478ba1928374650

# Envelope Master Key (Must be 32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Private Supabase Storage (Server Service Key ONLY - Never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=documents

# Google Gemini API (Phase 5 - Suggestions Only, Free tier)
GEMINI_API_KEY=

# Seed Accounts Default Password (Used by db:init)
SEED_DEFAULT_PASSWORD=Password@Argus2026!
